{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vaal Street Setup",
  "mainBinaryName": "VaalStreetSetup",
  "version": "1.0.0",
  "identifier": "local.vaalstreet.setup",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'" }
  },
  "bundle": {
    "active": false,
    "icon": ["../src-tauri/icons/32x32.png", "../src-tauri/icons/128x128.png", "../src-tauri/icons/icon.ico"]
  }
}